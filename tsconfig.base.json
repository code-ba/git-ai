{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true
  }
}
