{
  "name": "git-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "lint": "eslint . --ext .js,.mjs,.cjs,.mts",
    "lint:fix": "eslint . --ext .js,.mjs,.cjs,.mts --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "version:bump": "node scripts/bump-version.mjs",
    "prepare": "husky install",
    "prepublishOnly": "npm run lint && npm run format && npm run build"
  },
  "devDependencies": {
    "@types/cli-spinner": "0.2.3",
    "@types/configstore": "6.0.2",
    "@types/inquirer": "7.3.3",
    "@types/node": "22.20.7",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "eslint": "8.57.0",
    "husky": "^9.1.7",
    "lerna": "9.0.7",
    "lint-staged": "^16.2.7",
    "prettier": "2.8.8",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.mts": [
      "eslint --fix"
    ]
  }
}
